def PresentationComplex.completeStatement.{u, v} : Prop :=
∀ {S : Type u} {R : Type v} (r : R → FreeGroup S),
  ∃ cw b e,
    T2Space (PresentationComplex.Space r) ∧
      PathConnectedSpace (PresentationComplex.Space r) ∧
        (∀ (n : ℕ), 2 < n → IsEmpty (Topology.CWComplex.cell Set.univ n)) ∧
          (∀ (s : S), b (Path.Homotopic.Quotient.mk (PresentationComplex.edgeLoop s)) = FreeGroup.of s) ∧
            e.toMonoidHom.comp
                  (CellAttachment.inclusionPi1 (PresentationComplex.relatorMap r) (PresentationComplex.base S)) =
                (QuotientGroup.mk' (PresentationComplex.relatorNormalClosure r)).comp b.toMonoidHom ∧
              ∀ (s : S),
                e (Path.Homotopic.Quotient.mk ((PresentationComplex.edgeLoop s).map ⋯)) =
                  (QuotientGroup.mk' (PresentationComplex.relatorNormalClosure r)) (FreeGroup.of s)
PresentationComplex.every_group_fundamental_group.{u} (G : Type u) [Group G] :
  ∃ cw,
    T2Space (PresentationComplex.EveryGroupSpace G) ∧
      PathConnectedSpace (PresentationComplex.EveryGroupSpace G) ∧
        (∀ (n : ℕ), 2 < n → IsEmpty (Topology.CWComplex.cell Set.univ n)) ∧
          Nonempty (Topology.CWComplex.cell Set.univ 2) ∧
            Nonempty
              (FundamentalGroup (PresentationComplex.EveryGroupSpace G) (PresentationComplex.everyGroupPoint G) ≃* G)
PresentationComplex.everyGroupPi1Equiv_generator.{u} (G : Type u) [Group G] (g : G) :
  (PresentationComplex.everyGroupPi1Equiv G) (Path.Homotopic.Quotient.mk ((PresentationComplex.edgeLoop g).map ⋯)) = g
